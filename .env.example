# JSON mapping of unique consumer identifiers to distinct secrets (32+ characters).
API_CLIENTS={"example":"replace-with-a-long-random-secret-at-least-32-characters"}
REDIS_URL=redis://localhost:56379
API_SPORTS_KEY=replace-with-provider-key
# Teto diário local por modalidade; 0 desativa. Confirme a cota do plano.
API_SPORTS_DAILY_LIMIT=0
# Orçamento agregado por minuto; configure conforme o plano e as demais casas.
# Todas as réplicas devem usar os mesmos valores e o mesmo Redis.
API_SPORTS_MAX_REQUESTS_PER_MINUTE=10
API_SPORTS_BACKGROUND_MAX_REQUESTS_PER_MINUTE=6
FOOTBALL_SYNC_ENABLED=false
FOOTBALL_SYNC_CRON=* * * * *
# Descobre partidas futuras do dia UTC e sincroniza até duas por rodada.
FOOTBALL_SYNC_DISCOVERY=false
# Até três IDs, separados por vírgula. Odds sempre permanecem como prévia.
FOOTBALL_SYNC_FIXTURE_IDS=

# Basquete: sincronização de agenda e prévia de mercados individuais.
# As seleções permanecem bloqueadas para apostas e apuração.
BASKETBALL_SYNC_ENABLED=false
BASKETBALL_SYNC_CRON=* * * * *
# 12 = NBA; deixe vazio para todas as ligas (até dez IDs separados por vírgulas).
BASKETBALL_SYNC_LEAGUE_IDS=12
BASKETBALL_SYNC_BATCH_SIZE=2

# Local Docker environment (not a production credential).
DATABASE_URL=postgresql://api_sports:local-dev-only@localhost:55432/api_sports
